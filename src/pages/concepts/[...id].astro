---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  return concepts.map((concept) => ({
    params: { id: concept.id },
    props: { concept },
  }));
}

const { concept } = Astro.props;
const base = import.meta.env.BASE_URL;
const { Content } = await render(concept);

const exercises = (await getCollection('exercises'))
  .filter((exercise) => exercise.data.concepts.includes(concept.id))
  .sort((a, b) => a.data.order - b.data.order);

const prereqs = (
  await Promise.all(concept.data.prereqs.map((id) => getEntry('concepts', id)))
).filter((entry): entry is CollectionEntry<'concepts'> => entry !== undefined);
---

<Base title={`${concept.data.title} · Theory · Guitar Practice`}>
  <article>
    <p class="crumb"><a href={`${base}concepts/`}>Theory</a></p>
    <h1>{concept.data.title}</h1>
    <p class="goal">{concept.data.summary}</p>

    <div class="prose"><Content /></div>

    {
      prereqs.length > 0 && (
        <section class="related">
          <h2>Read first</h2>
          <ul>
            {prereqs.map((entry) => (
              <li>
                <a href={`${base}concepts/${entry.id}/`}>{entry.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      exercises.length > 0 && (
        <section class="related">
          <h2>Exercises that use it</h2>
          <ul>
            {exercises.map((exercise) => (
              <li>
                <a href={`${base}exercises/${exercise.id}/`}>{exercise.data.title}</a>
                {' — '}
                {exercise.data.goal}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>
