---
interface Props {
  tex: string;
  bpmStart: number;
  bpmTarget: number;
}

const { tex, bpmStart, bpmTarget } = Astro.props;
const startPercent = Math.min(120, Math.max(40, Math.round((bpmStart / bpmTarget) * 100)));
---

<div class="player">
  <div class="alpha-tab" data-role="score">{tex}</div>

  <div class="player-controls">
    <button type="button" data-action="play" disabled>Loading player…</button>

    <div class="mode-switch" role="group" aria-label="Playback mode">
      <button type="button" data-action="mode" data-mode="demo" aria-pressed="true">Demo</button>
      <button type="button" data-action="mode" data-mode="playalong" aria-pressed="false">
        Play-along
      </button>
    </div>

    <label class="control">
      <span>Speed</span>
      <input
        type="range"
        min="40"
        max="120"
        step="5"
        value={startPercent}
        data-action="speed"
      />
      <output data-role="speed-label">{startPercent}%</output>
    </label>
  </div>

  <p class="player-hint" data-role="hint">Guitar only — listen to the part.</p>
  <p class="player-error" data-role="error" hidden></p>
</div>

<script>
  import * as alphaTab from '@coderline/alphatab';
  import { base } from '../lib/url';

  const STORAGE_KEY = 'guitar-practice-mode';

  type Mode = 'demo' | 'playalong';

  interface ModeConfig {
    /** 0 = silent, 1 = full volume. */
    metronome: number;
    /** One-bar lead-in before playback starts. */
    countIn: number;
    /** True when the guitar itself should be silenced. */
    muteGuitar: boolean;
    hint: string;
    startLabel: string;
  }

  const MODES: Record<Mode, ModeConfig> = {
    demo: {
      metronome: 0,
      countIn: 0,
      muteGuitar: false,
      hint: 'Guitar only — listen to the part.',
      startLabel: 'Play demo',
    },
    playalong: {
      metronome: 0.7,
      countIn: 0.7,
      muteGuitar: true,
      hint: 'Guitar muted. One bar of count-in, then you play along.',
      startLabel: 'Start play-along',
    },
  };

  function readSavedMode(): Mode {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved === 'demo' || saved === 'playalong') return saved;
    } catch {
      // Private browsing or storage disabled: fall back to the default.
    }
    return 'demo';
  }

  function saveMode(mode: Mode): void {
    try {
      localStorage.setItem(STORAGE_KEY, mode);
    } catch {
      // Persisting the choice is a nicety, not a requirement.
    }
  }

  for (const root of document.querySelectorAll<HTMLElement>('.player')) {
    const host = root.querySelector<HTMLElement>('[data-role="score"]');
    const playButton = root.querySelector<HTMLButtonElement>('[data-action="play"]');
    const speedInput = root.querySelector<HTMLInputElement>('[data-action="speed"]');
    const speedLabel = root.querySelector<HTMLOutputElement>('[data-role="speed-label"]');
    const hint = root.querySelector<HTMLElement>('[data-role="hint"]');
    const errorBox = root.querySelector<HTMLElement>('[data-role="error"]');
    const modeButtons = [
      ...root.querySelectorAll<HTMLButtonElement>('[data-action="mode"]'),
    ];

    if (!host || !playButton || !speedInput || !speedLabel) continue;

    try {
      const api = new alphaTab.AlphaTabApi(host, {
        core: {
          tex: true,
          fontDirectory: `${base}font/`,
        },
        player: {
          enablePlayer: true,
          soundFont: `${base}audio/generaluser-gs-2.0.3.sf3`,
        },
      });

      let mode = readSavedMode();
      let playing = false;

      const updatePlayLabel = () => {
        playButton.textContent = playing ? 'Pause' : MODES[mode].startLabel;
      };

      const applyMode = () => {
        const config = MODES[mode];
        api.metronomeVolume = config.metronome;
        api.countInVolume = config.countIn;

        // The score arrives asynchronously; re-applied from scoreLoaded below.
        if (api.score) {
          api.changeTrackMute(api.score.tracks, config.muteGuitar);
        }

        for (const button of modeButtons) {
          button.setAttribute('aria-pressed', String(button.dataset.mode === mode));
        }
        if (hint) hint.textContent = config.hint;
        updatePlayLabel();
      };

      const applySpeed = () => {
        const percent = Number(speedInput.value);
        api.playbackSpeed = percent / 100;
        speedLabel.textContent = `${percent}%`;
      };

      applySpeed();
      applyMode();
      api.scoreLoaded.on(() => applyMode());

      api.playerStateChanged.on(({ state }) => {
        playing = state === alphaTab.synth.PlayerState.Playing;
        updatePlayLabel();
      });

      playButton.disabled = false;

      speedInput.addEventListener('input', applySpeed);

      playButton.addEventListener('click', () => {
        // Guard against a click that lands before the score has loaded.
        applyMode();
        api.playPause();
      });

      for (const button of modeButtons) {
        button.addEventListener('click', () => {
          const next = button.dataset.mode;
          if (next !== 'demo' && next !== 'playalong') return;

          mode = next;
          saveMode(mode);
          applyMode();
        });
      }
    } catch (error) {
      playButton.textContent = 'Player unavailable';
      if (errorBox) {
        errorBox.hidden = false;
        errorBox.textContent = `The tab could not be loaded: ${(error as Error).message}`;
      }
    }
  }
</script>
