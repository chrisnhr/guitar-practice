---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { base } from '../lib/url';

const [exercises, tracks] = await Promise.all([
  getCollection('exercises'),
  getCollection('tracks'),
]);

const sortedTracks = tracks.sort((a, b) => a.data.order - b.data.order);
const trackOrder = new Map(sortedTracks.map((track) => [track.id, track.data.order]));
const curriculum = [...exercises].sort((a, b) => {
  const trackDifference =
    (trackOrder.get(a.data.track) ?? 0) - (trackOrder.get(b.data.track) ?? 0);
  return trackDifference || a.data.order - b.data.order;
});
const next = curriculum[curriculum.length - 1];
---

<Base>
  <section class="hero">
    <h1>Practice the guitar you have.</h1>
    <p>
      Short, playable exercises for a steel-string acoustic, with the theory attached to each
      one. Rock, punk and metal are the destination, not the starting point.
    </p>
    {next && <a class="button" href={`${base}exercises/${next.id}/`}>Start: {next.data.title}</a>}
  </section>

  <section>
    <h2>Tracks</h2>
    <ul class="cards">
      {
        sortedTracks.map((track) => {
          const count = exercises.filter((exercise) => exercise.data.track === track.id).length;
          return (
            <li class="card">
              <h3><a href={`${base}tracks/${track.id}/`}>{track.data.title}</a></h3>
              <p>{track.data.focus}</p>
              <p class="meta">
                {count} {count === 1 ? 'exercise' : 'exercises'}
              </p>
            </li>
          );
        })
      }
    </ul>
  </section>

</Base>
